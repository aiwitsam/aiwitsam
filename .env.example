# GoHighLevel Credentials
GHL_EMAIL=your-ghl-login-email@example.com
GHL_PASSWORD=change-me
GHL_LOCATION_ID=your-location-id

# GoHighLevel API (Private Integration Token)
GHL_API_TOKEN=change-me

# ─── Stripe (for webhook verification) ─────────
# Required when the webhook bridge is armed (currently a skeleton — handler stub
# at webhooks/handlers/stripe.ts). Set this to the live LLC Stripe webhook secret
# at the time aiwitsam starts forwarding events to GoHighLevel.
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WHEN_ARMED

# Webhook Server
WEBHOOK_PORT=3900
WEBHOOK_HOST=127.0.0.1

# GHL Chat Widget ID (from GHL → Sites → Chat Widget → Get Code)
GHL_CHAT_WIDGET_ID=change-me

# GHL Tracking Pixel Location ID
GHL_TRACKING_LOCATION_ID=your-location-id

# GHL Calendar Widget URL (from GHL → Calendars → Embed)
GHL_CALENDAR_EMBED_URL=https://api.leadconnectorhq.com/widget/booking/change-me

# Social account handles (for GHL Social Planner verification)
SOCIAL_HANDLE_LINKEDIN=change-me
SOCIAL_HANDLE_INSTAGRAM=change-me
SOCIAL_HANDLE_YOUTUBE=change-me
SOCIAL_HANDLE_TIKTOK=change-me
SOCIAL_HANDLE_FACEBOOK=change-me
